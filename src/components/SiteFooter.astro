---
import EcoBadge from './EcoBadge.astro';
import Signature from './Signature.astro';
import { contact, site } from '../config';

const year = new Date().getFullYear();

const parcours = [
  { href: '/bilan/', label: 'Le bilan offert' },
  { href: '/accompagnement/', label: 'Accompagnement' },
  { href: '/ateliers/', label: 'Ateliers cuisine' },
  { href: '/l-eau/', label: "L'eau" },
  { href: '/mon-histoire/', label: 'Mon histoire' },
  { href: '/blog/', label: 'Conseils' },
];
---

<footer class="footer">
  <div class="container footer__meta">
    <nav class="footer__group footer__group--nav" aria-label="Le parcours">
      {parcours.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="footer__group footer__group--end">
      <a href={`tel:${contact.phoneLink}`}>{contact.phone}</a>
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <address>
        {contact.address.street}, {contact.address.zip}&nbsp;{
          contact.address.city
        }
      </address>

      <a class="footer__legal-item" href="/mentions-legales/">Mentions légales</a>
      <EcoBadge />
      <p class="footer__copyright">© {year} {site.name}.</p>
    </div>
  </div>

  {/* L'ancrage visuel : la baseline gravee dans le fond, qui deborde */}
  <p class="footer__wordmark" aria-hidden="true">{site.tagline}</p>

  <div class="footer__bar">
    <div class="container">
      <Signature />
    </div>
  </div>
</footer>

<style>
  .footer {
    --wordmark-gap: clamp(3rem, 8vw, 7rem);
    background: var(--color-green-deep);
    color: #d7e5da;
    margin-top: auto;
    overflow: hidden;
  }

  /*
   * `:global` est indispensable ici. Sans lui, la regle ne vise que les liens
   * ecrits dans ce fichier : ceux venant d'un composant enfant retombent sur
   * la couleur de lien globale, qui est le vert du fond. Texte invisible.
   *
   * `:not(.button)` ne sert plus aujourd'hui, le pied de page n'ayant plus de
   * bouton, mais il garde sa place : un bouton qu'on y remettrait serait
   * sinon repeint par cette regle.
   */
  .footer :global(a:not(.button)) {
    color: #d7e5da;
    text-decoration: none;
  }

  .footer :global(a:not(.button):hover) {
    color: #ffffff;
    text-decoration: underline;
  }

  /* ---- Les deux groupes de liens, qui se font face ---- */

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg) var(--space-xl);
    padding-top: var(--space-xl);
  }

  .footer__group {
    display: grid;
    gap: 0;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer__group--nav {
    justify-items: start;
  }

  .footer__group--end {
    justify-items: end;
    text-align: right;
  }

  /*
   * Chaque ligne devient une vraie cible tactile. Le padding vertical
   * remplace l'ecart de grille, pour que la hauteur serve a quelque chose.
   */
  .footer__group > *,
  .footer__group :global(.eco) {
    display: block;
    padding-block: 0.55rem;
  }

  .footer address {
    font-style: normal;
  }

  .footer__copyright {
    color: #c9dccd;
  }

  /* ---- Le filigrane ---- */

  .footer__wordmark {
    /*
     * Meme respiration au-dessus et en dessous, a l'oeil et non dans la
     * boite : l'italique de Lora monte moins haut que sa metrique ne le
     * laisse croire, ce qui laissait 94 px de vide en haut contre 67 en bas.
     * La correction est en em, pour suivre la taille fluide du texte.
     */
    margin-block: calc(var(--wordmark-gap) - 0.122em)
      calc(var(--wordmark-gap) + 0.122em);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(3rem, 11vw, 9rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
    white-space: nowrap;
    user-select: none;
    pointer-events: none;

    /* Grave dans le fond : un ton plus sombre, une arete claire en dessous */
    color: #10542e;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.09);
  }

  /* ---- La barre du bas ---- */

  .footer__bar {
    padding-block: 1.1rem 1.25rem;
    /* Un trait a peine pose, comme chez la reference */
    border-top: 1px solid rgb(234 242 236 / 0.14);

    /*
     * La phrase s'efface, le nom ressort d'un ton. La reference descend plus
     * bas encore, mais son gris tomberait a 3,2:1 sur ce vert : on s'arrete
     * au premier ton qui reste lisible.
     */
    --signature-text: #c9dccd;
    --signature-name: #eaf2ec;
  }

  .footer__bar :global(.signature) {
    font-size: var(--text-xs);
  }

  /*
   * La regle de lien du pied de page est aussi specifique que celle du
   * composant : il faut la reprendre ici pour que le nom ressorte.
   */
  .footer__bar :global(.signature a) {
    color: #eaf2ec;
  }

  .footer__bar :global(.signature a:hover) {
    color: #ffffff;
  }

  @media (max-width: 46rem) {
    /*
     * Sur grand ecran la baseline deborde volontairement de part et d'autre.
     * Sur telephone elle doit tenir entiere : la phrase mesure 10,29 em, donc
     * 9 vw la posent a 93 % de la largeur. Pas de plancher en rem ici, il
     * reprendrait le dessus et la ferait deborder.
     */
    .footer__wordmark {
      font-size: 9vw;
    }

    .footer__meta {
      flex-direction: column;
    }

    .footer__group--end {
      justify-items: start;
      text-align: left;
    }

  }
</style>
