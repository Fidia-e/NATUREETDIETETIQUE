---
import { Image } from 'astro:assets';
import { formatDate, frenchSpacing, readingTime, type Post } from '../lib/blog';

interface Props {
  post: Post;
  /** Seule la premiere carte visible au chargement charge son image tout de suite. */
  priority?: boolean;
}

const { post, priority = false } = Astro.props;
const { cover, coverAlt } = post.data;
---

<article class="article-card">
  {
    cover && (
      <Image
        class="article-card__cover"
        src={cover}
        alt={coverAlt ?? ''}
        widths={[360, 560, 720]}
        sizes="(min-width: 64rem) 360px, (min-width: 40rem) 45vw, 90vw"
        loading={priority ? 'eager' : 'lazy'}
      />
    )
  }
  <div class="article-card__meta">
    <span class="article-card__category">{post.data.category}</span>
    <span>{readingTime(post)} min de lecture</span>
  </div>
  <h3 class="article-card__title">
    <a href={`/blog/${post.id}/`}>{frenchSpacing(post.data.title)}</a>
  </h3>
  <p class="article-card__excerpt">{frenchSpacing(post.data.description)}</p>
  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-green-leaf);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .article-card__cover {
    width: calc(100% + 2 * var(--space-md));
    max-width: none;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: calc(-1 * var(--space-md)) calc(-1 * var(--space-md)) var(--space-2xs);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .article-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .article-card__category {
    background: var(--color-green-wash);
    color: var(--color-green-deep);
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
  }

  .article-card__title {
    font-size: var(--text-xl);
  }

  .article-card__title a {
    text-decoration: none;
  }

  /* Toute la carte devient cliquable sans imbriquer de lien */
  .article-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .article-card {
    position: relative;
  }

  .article-card__excerpt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    flex: 1;
  }

  .article-card time {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
