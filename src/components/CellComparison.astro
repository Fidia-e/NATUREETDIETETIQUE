---
import CellFigure from './CellFigure.astro';

/**
 * Schema de la membrane cellulaire : fonctionnement affaibli contre normal.
 * Redessine plutot qu'importe en image, pour rester net a toutes les tailles,
 * se reflow sur telephone et laisser le texte selectionnable et traduisible.
 */
const affected = [
  'Fonction cérébrale',
  'Santé des cheveux',
  'Fonction cardiaque',
  'Élasticité de la peau',
  'Organes internes',
  'Articulations et muscles',
];

interface Cell {
  tone: 'rigide' | 'souple';
  title: string;
  membrane: string;
  /** Libellés découpés ligne à ligne : le texte SVG ne se replie pas seul. */
  intake: string[];
  waste: string[];
}

const cells: Cell[] = [
  {
    tone: 'rigide',
    title: 'Fonctionnement affaibli',
    membrane: 'Membrane dure, rigide',
    intake: ['Les nutriments', 'sont absorbés', 'lentement'],
    waste: ['Les déchets', 'sont éliminés', 'lentement'],
  },
  {
    tone: 'souple',
    title: 'Fonctionnement normal',
    membrane: 'Membrane douce et souple',
    intake: ['Les nutriments', 'sont absorbés', 'facilement'],
    waste: ['Les déchets', 'sont éliminés', 'facilement'],
  },
];

/** Flèches entrantes, à gauche, et sortantes, en bas à droite. */

---

<section class="cells">
  <h3 class="cells__title">
    Voilà comment cela affecte <strong>les cellules de notre organisme</strong>
  </h3>

  <div class="cells__pair">
    {
      cells.map((cell) => (
        <article class:list={['cell', `cell--${cell.tone}`]}>
          <h4>{cell.title}</h4>
          <p class="cell__membrane">{cell.membrane}</p>

          <div class="cell__scene">
            <p class="cell__legend cell__legend--in">
              {cell.intake.join(' ')}
            </p>

            <CellFigure tone={cell.tone} />

            <p class="cell__legend cell__legend--out">
              {cell.waste.join(' ')}
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <div class="cells__affected">
    <p class="cells__affected-label">Ce que la qualité des membranes touche</p>
    <ul>
      {affected.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <p class="cells__ratio">
    Un rapport de <strong>3:1</strong> entre oméga-6 et oméga-3 est nécessaire
    pour des membranes cellulaires saines.
  </p>
</section>

<style>
  .cells {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-sm);
  }

  .cells__title {
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--color-text-muted);
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .cells__title strong {
    display: block;
    font-weight: 800;
    color: var(--color-green-deep);
  }

  .cells__pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: var(--space-md);
  }

  .cell {
    --tone: var(--color-green-deep);
    --tone-wash: var(--color-green-wash);
    text-align: center;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--tone);
    border-radius: var(--radius-md);
    background: #ffffff;
  }

  /* Le rouge n'est pas une couleur de marque : il porte ici le sens, et lui seul */
  .cell--rigide {
    --tone: #b4541f;
    --tone-wash: #fbeee6;
  }

  .cell--souple {
    --tone: var(--color-green-deep);
    --tone-wash: var(--color-green-wash);
  }

  .cell h4 {
    font-size: var(--text-lg);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tone);
  }

  .cell__membrane {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-2xs);
  }

  /* ----------------------------------------------------------------------
     La scene : libelle et fleches a gauche, cellule au centre, sortie a
     droite. Trois colonnes qui se replient en une seule sur telephone.
     ---------------------------------------------------------------------- */
  .cell__scene {
    display: grid;
    justify-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .cell__scene :global(.cell-figure) {
    width: 100%;
  }

  /*
   * Chaque legende se cale du cote de ses fleches : l'entree a gauche, la
   * sortie a droite. Centrees, elles ne designaient rien et on ne comprenait
   * pas qu'elles commentent les fleches.
   */
  .cell__legend {
    max-width: 17rem;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-style: italic;
    font-weight: 800;
    line-height: 1.3;
  }

  .cell__legend--in {
    justify-self: start;
    text-align: left;
    color: #2f7d3f;
  }

  .cell__legend--out {
    justify-self: end;
    text-align: right;
    color: #b58033;
  }

  .cells__affected {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .cells__affected-label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-green-leaf);
    text-align: center;
  }

  .cells__affected ul {
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35em var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /*
   * Du texte, pas des commandes. Les pastilles arrondies empruntaient le
   * vocabulaire des boutons et invitaient au clic : un simple point dore
   * separe desormais les termes.
   */
  .cells__affected li + li::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: var(--space-sm);
    vertical-align: 0.25em;
    border-radius: 50%;
    background: var(--color-gold);
  }

  .cells__ratio {
    max-width: 48rem;
    margin-top: var(--space-md);
    margin-inline: auto;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-gold-wash);
    border-left: 4px solid var(--color-gold);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    text-align: center;
    font-size: var(--text-sm);
  }

  .cells__ratio strong {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-green-deep);
  }


  @media (max-width: 46rem) {
    .cells {
      padding: var(--space-md);
    }

    .cell__scene {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: var(--space-sm);
    }

      .cell__legend {
      text-align: center;
    }

    /* Les fleches suivent la lecture : elles descendent au lieu d'aller a droite */
    .cell__arrows {
      width: 60%;
      transform: rotate(90deg);
    }
  }
</style>
