>
  <path
    d="M52 10c2.5 18.5-5.5 32.5-18.5 37C27 49.5 21.5 49.5 18 48c1-16 10-28.5 23-34.5 4-2 8-3 11-3.5z"
    fill="currentColor"
  ></path>
  <path
    d="M52 10C38 19 26.5 32 19.5 48.5"
