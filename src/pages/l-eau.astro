---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { links } from '../config';

/** Ce que la filtration retire réellement, et ce qu'elle ne retire pas. */
const filtration = [
  {
    method: 'Charbon actif',
    removes: 'Chlore, goûts et odeurs, une partie des pesticides et des résidus organiques.',
    limits: 'Ne retire ni le calcaire ni les nitrates. La cartouche se colonise si on ne la change pas.',
  },
  {
    method: 'Osmose inverse',
    removes: 'La très grande majorité des sels dissous, nitrates, métaux lourds et micropolluants.',
    limits: "Retire aussi les minéraux utiles, et rejette plusieurs litres pour un litre produit.",
  },
  {
    method: 'Ultraviolet',
    removes: 'Bactéries et virus, par inactivation. Utile sur une source privée.',
    limits: "N'enlève aucune substance chimique : l'eau doit déjà être claire.",
  },
];

const established = [
  "L'eau est le premier constituant du corps, de l'ordre de 60 à 70 % selon l'âge et la composition corporelle.",
  'Une hydratation insuffisante se voit sur la concentration, la fatigue, le transit et la récupération.',
  "La filtration au charbon actif améliore réellement le goût, et retire une part des résidus organiques.",
  'Le calcaire est un fait mesurable, qui se traite et se constate sur les installations.',
];

const notEstablished = [
  "Que l'eau conserverait une « mémoire » ou des « informations vibratoires ».",
  "Qu'une eau « dynamisée » ou « énergétisée » agirait différemment d'une eau filtrée de qualité équivalente.",
  "Qu'un sourcier ou un géobiologue puisse constituer une vérification.",
  "Qu'un traitement de l'eau puisse guérir quoi que ce soit.",
];

const together = [
  {
    title: 'Combien vous buvez vraiment',
    text: "Presque tout le monde surestime sa consommation. On la mesure sur trois jours, sans jugement, et le chiffre réel surprend souvent.",
  },
  {
    title: 'Quand vous buvez',
    text: "Un litre et demi avalé le soir ne vaut pas la même chose qu'une répartition sur la journée. C'est le réglage le plus simple à obtenir.",
  },
  {
    title: 'Ce que vous buvez',
    text: "Café, thé, sodas, jus : tous ne se valent pas, et certains comptent dans votre apport. On fait le tri sur ce que vous consommez déjà.",
  },
  {
    title: 'La qualité à la maison',
    text: "Si la filtration vous intéresse, on regarde ce qui est pertinent chez vous : la dureté de votre commune, votre installation, votre budget.",
  },
];
---

<BaseLayout
  title="L'eau, sa qualité et sa filtration"
  description="Pourquoi l'eau compte, ce que la filtration retire vraiment, ce que propose Sonatec, et ce qui est établi ou non à ce sujet."
>
  <PageHero
    eyebrow="L'eau"
    title="Nous sommes faits d'eau à 70 %"
    lead="C'est le premier constituant de nos cellules, et le plus facile à négliger. Avant tout protocole, une question simple : quelle eau buvez-vous, et en quelle quantité ?"
  />

  <section class="section">
    <div class="container intro">
      <div class="prose stack">
        <h2>Le point de départ</h2>
        <p>
          On parle volontiers de compléments, de protocoles et de superaliments.
          Pendant ce temps, beaucoup de gens boivent un litre par jour sans le
          savoir, et s'étonnent d'être fatigués. C'est le levier le moins cher
          et le plus rapide de tous, et c'est presque toujours par là que je
          commence.
        </p>
        <p>
          La qualité vient ensuite. L'eau du robinet suisse est contrôlée et
          potable, ce qui n'est pas rien. Elle reste une eau traitée, poussée
          sous pression dans des canalisations, parfois très calcaire selon la
          commune, et elle transporte des résidus que le traitement ne retire
          pas tous.
        </p>
      </div>

      <Photo
        name="nature-phyto"
        alt="Plantes conservées dans des fioles de verre, à côté d'une fiole d'huile"
        width={642}
        height={1010}
        ratio="4 / 5"
        focus="center 60%"
      />
    </div>
  </section>

  <section class="section section--wash">
    <div class="container">
      <p class="eyebrow">Filtrer</p>
      <h2>Ce que chaque procédé retire, et ce qu'il laisse</h2>
      <p class="lead section__lead">
        Aucun procédé ne fait tout. Savoir ce que fait le vôtre évite d'acheter
        deux fois la même fonction, ou de croire réglé un problème qui ne l'est
        pas.
      </p>

      <div class="grid grid--3 methods">
        {
          filtration.map((item) => (
            <article class="method">
              <h3>{item.method}</h3>
              <p class="method__label">Retire</p>
              <p>{item.removes}</p>
              <p class="method__label method__label--limit">Ne retire pas</p>
              <p>{item.limits}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">La démarche Sonatec</p>
      <h2>Ce qu'ils proposent, dans leurs termes</h2>

      <div class="prose stack sonatec">
        <p>
          Sonatec est une entreprise suisse qui travaille sur l'eau domestique
          depuis plusieurs décennies. Leur gamme combine des éléments très
          classiques, filtration au charbon actif, osmose inverse,
          stérilisation aux ultraviolets, et un réacteur dit
          magnéto-hydro-dynamique, sans sel, sans électricité et sans produit
          chimique.
        </p>
        <p>
          Sur le calcaire, leur promesse est concrète et vérifiable sur une
          installation : moins de dépôt, et un calcaire existant qui se
          détache. C'est de la physico-chimie de l'eau, et cela s'observe.
        </p>
        <p>
          Ils vont ensuite plus loin, avec deux notions qui leur sont propres :
          la <strong>dynamisation</strong> et l'<strong>énergétisation</strong>.
          Il s'agirait d'une eau qui reçoit et conserve des « fréquences » et
          des « informations vibratoires », avec une organisation moléculaire
          particulière, et des bénéfices annoncés sur le transit, l'absorption
          des vitamines et la vitalité des cellules.
        </p>
      </div>

      <div class="grid grid--2 verdict">
        <article class="verdict__card verdict__card--yes">
          <h3>Ce qui est établi</h3>
          <ul>
            {established.map((item) => <li>{item}</li>)}
          </ul>
        </article>

        <article class="verdict__card verdict__card--no">
          <h3>Ce qui ne l'est pas</h3>
          <ul>
            {notEstablished.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>

      <p class="honesty">
        Je vous présente cette approche parce qu'elle fait partie de ce que
        j'utilise, et je préfère vous dire où passe la frontière plutôt que de
        vous laisser la découvrir ailleurs. Les effets de la dynamisation ne
        font l'objet d'aucun consensus scientifique, et la vérification par un
        sourcier n'en est pas une. Si cette partie ne vous parle pas, elle n'est
        indispensable à rien de ce que nous ferons ensemble.
      </p>
    </div>
  </section>

  <section class="section section--wash">
    <div class="container">
      <p class="eyebrow">Concrètement</p>
      <h2>Ce qu'on travaille ensemble</h2>
      <div class="grid grid--2 together">
        {
          together.map((item) => (
            <article class="card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--green">
    <div class="container cta">
      <div>
        <h2>L'eau est un début, pas une conclusion</h2>
        <p class="lead">
          Le bilan en ligne fait le tour du reste en trois minutes : énergie,
          douleurs, digestion, moral.
        </p>
      </div>
      <div class="cta__actions">
        <a class="button button--gold" href="/bilan/">Faire le bilan</a>
        <a class="button button--ghost" href="/rendez-vous/">Réserver 15 min</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p class="source">
        Source de la partie consacrée à leur démarche : le site de{' '}
        <a href={links.sonatec} target="_blank" rel="noopener noreferrer">
          Sonatec
        </a>, pages « Dynamisation » et « Énergétisation ».
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .section__lead {
    max-width: 56ch;
    margin-top: var(--space-sm);
  }

  .methods {
    margin-top: var(--space-lg);
  }

  .method {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
  }

  .method h3 {
    font-size: var(--text-lg);
  }

  .method p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .method__label {
    margin-top: var(--space-sm);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-green-leaf);
  }

  .method__label--limit {
    color: var(--color-taupe);
  }

  .sonatec {
    margin-top: var(--space-md);
  }

  .sonatec strong {
    color: var(--color-green-deep);
  }

  .verdict {
    margin-top: var(--space-lg);
    align-items: stretch;
  }

  .verdict__card {
    padding: var(--space-md);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .verdict__card h3 {
    font-size: var(--text-lg);
  }

  .verdict__card ul {
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
    display: grid;
    gap: var(--space-xs);
    font-size: var(--text-sm);
  }

  .verdict__card li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs);
  }

  .verdict__card li::before {
    margin-top: 0.05em;
    font-family: var(--font-ui);
    font-weight: 900;
  }

  .verdict__card--yes {
    background: var(--color-green-wash);
    border-color: var(--color-green-leaf);
  }

  .verdict__card--yes li::before {
    content: '✓';
    color: var(--color-green-deep);
  }

  .verdict__card--no {
    background: var(--color-surface-alt);
  }

  .verdict__card--no li::before {
    content: '–';
    color: var(--color-taupe);
  }

  .honesty {
    max-width: var(--width-prose);
    margin-top: var(--space-lg);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-gold-wash);
    border-left: 4px solid var(--color-gold);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: var(--text-sm);
  }

  .together {
    margin-top: var(--space-lg);
  }

  .together h3 {
    font-size: var(--text-lg);
  }

  .together p {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .cta .lead {
    max-width: 48ch;
    margin-top: var(--space-2xs);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .source {
    max-width: 72ch;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 60rem) {
    .intro {
      grid-template-columns: 1fr;
    }
  }
</style>
