# =========================================================================
#  natureetdietetique.com : configuration Apache / LiteSpeed (o2switch)
#
#  Ce fichier est dans public/, donc Astro le recopie dans dist/ à chaque
#  build : il part avec le site, il n'y a rien à réinstaller à la main.
#
#  Les pages sont des dossiers (dist/bilan/index.html) et leur adresse
#  canonique finit par « / ». Apache ajoute lui-même la barre finale à /bilan :
#  ne jamais la retirer ici, chaque page tournerait en boucle.
# =========================================================================

Options -Indexes

# ---- Fichiers qui ne doivent jamais être servis ------------------------
# config.php contient le jeton GitHub et l'empreinte du mot de passe.
<FilesMatch "^(config\.php|config-exemple\.php)$">
  Require all denied
</FilesMatch>

RewriteEngine On

# ---- Une seule adresse : https, sans www -------------------------------
# Les deux conditions sont dans la MÊME règle : un visiteur arrivant sur
# http://www. ne subit qu'une redirection au lieu de deux. L'hôte est repris
# de la demande : la préprod reste sur test.natureetdietetique.ch, au lieu
# d'envoyer ses visiteurs sur le vrai site.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ---- Préprod : hors des moteurs de recherche ---------------------------
# Le même build sert la préprod et le vrai site : seul l'hôte les distingue.
# robots.txt reste ouvert, sinon Google ne verrait jamais cet en-tête.
SetEnvIfNoCase Host ^test\. PREPROD
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=PREPROD
</IfModule>

ErrorDocument 404 /404.html

# ---- Compression -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml image/svg+xml
</IfModule>

# ---- Cache -------------------------------------------------------------
<IfModule mod_headers.c>
  # Styles, scripts et polices portent une empreinte dans leur nom : un contenu
  # modifié change de nom. On peut les garder un an sans risque.
  <FilesMatch "\.(woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Les photos de public/images gardent le même nom : un mois, sans « immutable ».
  <FilesMatch "\.(avif|webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---- Types MIME --------------------------------------------------------
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2

AddDefaultCharset UTF-8
